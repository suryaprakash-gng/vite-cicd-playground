  <diagram id="trunk-based-s3-branching-cicd" name="Branching Strategy &amp; AWS S3 CI/CD Flow">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ==================== HEADER BANNER ==================== -->
        <mxCell id="header_box" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=#1e293b;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1620" height="90" as="geometry" />
        </mxCell>
        <mxCell id="header_title" value="&lt;div style=&quot;font-size: 20px; font-weight: 700; color: #ffffff;&quot;&gt;Trunk-Based Branching Strategy &amp;amp; Multi-Stage AWS S3 / CloudFront CI/CD Pipeline&lt;/div&gt;&lt;div style=&quot;font-size: 13px; color: #94a3b8; margin-top: 4px;&quot;&gt;Vite SPA • Ephemeral Dev Previews • Semantic Versioning (Release Please) • Immutable S3 Artifact Sync • Gated Production&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Inter,Segoe UI,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="65" y="42" width="1050" height="66" as="geometry" />
        </mxCell>
        <mxCell id="badge_repo" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b style=&quot;color: #f97316;&quot;&gt;TARGET:&lt;/b&gt; Amazon S3 + CloudFront&lt;br&gt;&lt;b style=&quot;color: #38bdf8;&quot;&gt;TRUNK:&lt;/b&gt; main &amp;nbsp;|&amp;nbsp; &lt;b style=&quot;color: #34d399;&quot;&gt;REPO:&lt;/b&gt; vite-cicd-playground&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#334155;strokeWidth=1.5;fontColor=#f8fafc;fontSize=11;fontFamily=Inter,Segoe UI,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1340" y="47" width="290" height="56" as="geometry" />
        </mxCell>

        <!-- ==================== CONTAINER 1: PHASE 1 DEV PREVIEW ==================== -->
        <mxCell id="c1" value="&lt;b&gt;PHASE 1: Feature Development, Pull Request &amp;amp; Ephemeral S3 Dev Preview&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;strokeWidth=1.5;align=left;verticalAlign=top;spacingLeft=16;spacingTop=12;fontFamily=Inter,Segoe UI,sans-serif;fontSize=13;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="1620" height="205" as="geometry" />
        </mxCell>

        <!-- Feature Branch -->
        <mxCell id="b_feat" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;feat/* or fix/*&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #6b21a8;&quot;&gt;Short-Lived Feature Branch&lt;/span&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #c084fc; margin: 4px 0;&quot;&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;• Branch off &lt;b&gt;main&lt;/b&gt;&lt;br&gt;• Conventional Commits&lt;br&gt;• Pre-commit hooks (Husky)&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#faf5ff;strokeColor=#a855f7;strokeWidth=2;fontFamily=Inter,Segoe UI,sans-serif;fontColor=#581c87;" vertex="1" parent="1">
          <mxGeometry x="70" y="185" width="210" height="135" as="geometry" />
        </mxCell>

        <!-- Open PR -->
        <mxCell id="step_pr" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Pull Request&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #1e40af;&quot;&gt;Target: main&lt;/span&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #93c5fd; margin: 4px 0;&quot;&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;• Automated CI trigger&lt;br&gt;• Peer review gate&lt;br&gt;• Branch protection check&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontFamily=Inter,Segoe UI,sans-serif;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="340" y="185" width="200" height="135" as="geometry" />
        </mxCell>

        <!-- CI Workflow Box -->
        <mxCell id="step_ci" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Workflow: ci.yml (check)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #065f46;&quot;&gt;Automated Quality Gate&lt;/span&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #6ee7b7; margin: 4px 0;&quot;&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;1. &lt;b&gt;pnpm lint&lt;/b&gt; (ESLint, Stylelint)&lt;br&gt;2. &lt;b&gt;pnpm format:check&lt;/b&gt; (Prettier)&lt;br&gt;3. &lt;b&gt;pnpm test&lt;/b&gt; (Vitest)&lt;br&gt;4. &lt;b&gt;pnpm build&lt;/b&gt; (Vite dev bundle)&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=2;fontFamily=Inter,Segoe UI,sans-serif;fontColor=#064e3b;" vertex="1" parent="1">
          <mxGeometry x="600" y="185" width="250" height="135" as="geometry" />
        </mxCell>

        <!-- Dev Artifact -->
        <mxCell id="art_dev" value="&lt;b&gt;Dev Artifact&lt;/b&gt;&lt;br&gt;&lt;code style=&quot;font-size: 11px;&quot;&gt;site-pr-&amp;lt;PR#&amp;gt;&lt;/code&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #854d0e;&quot;&gt;Retention: 7 Days&lt;/span&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fefce8;strokeColor=#eab308;strokeWidth=2;fontFamily=Inter,Segoe UI,sans-serif;fontColor=#713f12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="195" width="150" height="115" as="geometry" />
        </mxCell>

        <!-- Deploy Dev to S3 -->
        <mxCell id="step_deploy_dev" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;deploy.yml (dev)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 10px; color: #c2410c;&quot;&gt;AWS S3 Sync &amp;amp; Invalidation&lt;/span&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #fed7aa; margin: 4px 0;&quot;&gt;&lt;div style=&quot;font-size: 11px; text-align: left;&quot;&gt;• &lt;b&gt;aws s3 sync&lt;/b&gt; prebuilt dist/&lt;br&gt;• &lt;b&gt;assets/&lt;/b&gt; → immutable 1y cache&lt;br&gt;• &lt;b&gt;index.html&lt;/b&gt; → no-cache&lt;br&gt;• CloudFront invalidation /*&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=2;fontFamily=Inter,Segoe UI,sans-serif;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="1110" y="185" width="230" height="135" as="geometry" />
        </mxCell>

        <!-- AWS S3 Dev Target -->
        <mxCell id="env_dev" value="&lt;b style=&quot;font-size: 13px; color: #ffffff;&quot;&gt;📦 Amazon S3 (Dev Bucket)&lt;/b&gt;&lt;hr style=&quot;border: 0; border-top: 1px solid #f97316; margin: 4px 0;&quot;&gt;&lt;div style=&quot;font-size: 10px; color: #ffedd5; text-align: left;&quot;&gt;• &lt;b style=&quot;color: #fdba74;&quot;&gt;s3://vite-cicd-dev-bucket&lt;/b&gt;&lt;br&gt;• Ephemeral PR preview route&lt;br&gt;• CloudFront Dev CDN distribution&lt;br&gt;• Live stakeholder testing&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#431407;strokeColor=#ea580c;strokeWidth=2.5;fontFamily=Inter,Segoe UI,sans-serif;" vertex="1" parent="1">
          <mxGeometry x="1390" y="185" width="240" height="135" as="geometry" />
        </mxCell>

        <!-- Edges Phase 1 -->
        <mxCell id="e1" value="git push" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8b5cf6;strokeWidth=2;fontFamily=Inter,Segoe UI,sans-serif;fontSize=11;fontColor=#6b21a8;" edge="1" parent="1" source="b_feat" target="step_pr">
          <mxGeometry relative="1" as="geometry" />
